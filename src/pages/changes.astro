---
import Base from '../layouts/Base.astro'
import { androidEntries, pwaEntries, type Entry } from '../lib/changelog'
import { formatDate, href } from '../lib/site'

const LIMIT = 25
const tabs: { id: Entry['platform']; label: string; platform: string; entries: Entry[]; empty: string }[] = [
  {
    id: 'android',
    label: 'Android',
    platform: 'android',
    entries: androidEntries.slice(0, LIMIT),
    empty: 'Первый выпуск для Android готовится. Пока на Android можно пользоваться веб-версией.',
  },
  { id: 'pwa', label: 'Веб и iPhone', platform: 'ios desktop', entries: pwaEntries.slice(0, LIMIT), empty: 'Выпусков пока нет.' },
]
---

<Base
  title="Что нового — MBT: My Budget Tracker"
  description="Новые версии MBT для Android, веба и iPhone: что добавлено, изменено и исправлено."
  path="changes/"
>
  <main id="main">
    <div class="relative overflow-hidden pt-28 pb-10 sm:pt-36">
      <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -top-48 left-1/2 h-96 w-[48rem] -translate-x-1/2 rounded-full bg-emerald-500/15 blur-[120px]"></div>
      <div class="relative mx-auto max-w-3xl px-4 sm:px-6">
        <p class="text-sm font-medium text-emerald-400">Что нового</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Новые версии</h1>
        <p class="mt-5 text-lg text-fg-muted text-pretty">
          Что изменилось в каждой версии. Веб-версия обновляется сама; о новых версиях можно узнавать и через
          <a href={href('rss.xml')} class="text-emerald-300 underline underline-offset-4">RSS-ленту</a>.
        </p>
      </div>
    </div>

    <div class="mx-auto max-w-3xl px-4 pb-24 sm:px-6">
      <div role="tablist" data-tabs aria-label="Платформа" class="flex w-fit gap-1 rounded-full border border-white/10 bg-zinc-900 p-1 text-sm">
        {
          tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              data-platform={t.platform}
              aria-controls={`changes-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? undefined : '-1'}
              class="rounded-full px-4 py-2 text-fg-muted transition aria-selected:bg-white aria-selected:text-zinc-950"
            >
              {t.label}
            </button>
          ))
        }
      </div>

      {
        tabs.map((t, i) => (
          <div id={`changes-${t.id}`} role="tabpanel" aria-labelledby={`tab-${t.id}`} class="mt-10" hidden={i !== 0}>
            {t.entries.length === 0 ? (
              <p class="card p-7 text-fg-muted">{t.empty}</p>
            ) : (
              <ol class="space-y-6">
                {t.entries.map((e, n) => (
                  <li id={`${e.platform}-${e.version}`} class="card scroll-mt-24 p-6 sm:p-7">
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <h2 class="text-xl font-semibold tabular-nums">Версия {e.version}</h2>
                      <time datetime={e.date} class="text-sm text-fg-muted">{formatDate(e.date)}</time>
                      {n === 0 && <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-xs font-medium text-emerald-300">последняя</span>}
                    </div>
                    <div class="prose-md" set:html={e.html} />
                  </li>
                ))}
              </ol>
            )}
          </div>
        ))
      }
    </div>
  </main>
</Base>
